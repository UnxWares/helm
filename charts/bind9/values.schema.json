{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "adminService": {
            "type": "object",
            "properties": {
                "annotations": {
                    "description": "Admin Service annotations.",
                    "type": "object"
                },
                "type": {
                    "description": "Admin Service type. Keep it internal: rndc and the metrics are administrative ports.",
                    "type": "string",
                    "enum": [
                        "ClusterIP",
                        "NodePort",
                        "LoadBalancer"
                    ]
                }
            }
        },
        "affinity": {
            "description": "Affinity rules.",
            "type": "object"
        },
        "autoscaling": {
            "type": "object",
            "properties": {
                "enabled": {
                    "description": "Enable the HorizontalPodAutoscaler (static zones only: no persistence).",
                    "type": "boolean"
                },
                "maxReplicas": {
                    "description": "Maximum number of replicas.",
                    "type": "integer"
                },
                "minReplicas": {
                    "description": "Minimum number of replicas.",
                    "type": "integer"
                },
                "targetCPUUtilizationPercentage": {
                    "description": "Target average CPU utilization (%).",
                    "type": "integer"
                },
                "targetMemoryUtilizationPercentage": {
                    "description": "Target average memory utilization (%). Empty: no memory target.",
                    "type": [
                        "integer",
                        "null"
                    ]
                }
            }
        },
        "bind": {
            "type": "object",
            "properties": {
                "args": {
                    "description": "Extra arguments passed to named (after `-g`).",
                    "type": "array"
                },
                "namedConf": {
                    "description": "named.conf content. The default is a minimal authoritative-only server: add your zones (see `bind.zones`). Keep `directory \"/var/cache/bind\";`: it is the only writable working directory. https://bind9.readthedocs.io/en/stable/reference.html",
                    "type": "string"
                },
                "zones": {
                    "description": "Zone files, mounted as `/etc/bind/\u003ckey\u003e.zone`.",
                    "type": "object"
                }
            }
        },
        "fullnameOverride": {
            "description": "Override the full resource names.",
            "type": "string"
        },
        "image": {
            "type": "object",
            "properties": {
                "digest": {
                    "description": "Image digest (`sha256:...`). When set, it takes precedence over the tag.",
                    "type": "string"
                },
                "pullPolicy": {
                    "description": "Image pull policy.",
                    "type": "string",
                    "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                    ]
                },
                "repository": {
                    "description": "Bind9 image repository (ISC official image).",
                    "type": "string"
                },
                "tag": {
                    "description": "Image tag (defaults to the chart appVersion, the current ISC stable branch). `9.21` is ISC's development branch. The ISC image is published for linux/amd64 only: see `nodeSelector`.",
                    "type": "string"
                }
            }
        },
        "imageProvider": {
            "description": "Exporter image used when `metrics.image.repository` is empty. `unxwares`: `ghcr.io/unxwares/bind-exporter`, bind_exporter built by UnxWares from its sources (master branch, current Go toolchain and golang.org/x modules) on a distroless base, rebuilt twice a week (https://github.com/UnxWares/helm/tree/main/images). `upstream`: the Prometheus community image `docker.io/prometheuscommunity/bind-exporter`. named always runs the ISC image.",
            "type": "string",
            "enum": [
                "unxwares",
                "upstream"
            ]
        },
        "imagePullSecrets": {
            "description": "Secrets for pulling images from a private registry.",
            "type": "array"
        },
        "livenessProbe": {
            "description": "Liveness probe (dig exits 0 as soon as the server answers, whatever the answer).",
            "type": "object"
        },
        "metrics": {
            "type": "object",
            "properties": {
                "enabled": {
                    "description": "Run the Prometheus bind_exporter sidecar (reads the statistics channel on 127.0.0.1:8053).",
                    "type": "boolean"
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "digest": {
                            "description": "Exporter image digest (takes precedence over the tag).",
                            "type": "string"
                        },
                        "pullPolicy": {
                            "description": "Exporter image pull policy.",
                            "type": "string",
                            "enum": [
                                "Always",
                                "IfNotPresent",
                                "Never"
                            ]
                        },
                        "repository": {
                            "description": "Exporter image repository. Empty: `ghcr.io/unxwares/bind-exporter` or `docker.io/prometheuscommunity/bind-exporter`, from `imageProvider`.",
                            "type": "string"
                        },
                        "tag": {
                            "description": "Exporter image tag. Empty: `0.8.0-62-gbafd56f` (unxwares: the master commit bafd56f, 62 commits after v0.8.0) or `master@sha256:a1f46e6abf8d284a158a1ba0e3275bc2e17f9119ec227f18bdb20019d24b3bcf` (upstream: the master build of 2026-10-14, pinned by digest). v0.8.0, the latest release (November 2024), was built with an old Go toolchain.",
                            "type": "string"
                        }
                    }
                },
                "livenessProbe": {
                    "description": "Exporter liveness probe.",
                    "type": "object"
                },
                "readinessProbe": {
                    "description": "Exporter readiness probe.",
                    "type": "object"
                },
                "resources": {
                    "description": "Exporter resources.",
                    "type": "object"
                },
                "securityContext": {
                    "description": "Exporter security context (both images run as `nobody`).",
                    "type": "object"
                },
                "serviceMonitor": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "description": "Create a Prometheus Operator ServiceMonitor on the admin Service (requires `metrics.enabled`; rendered only when the CRD exists).",
                            "type": "boolean"
                        },
                        "endpoints": {
                            "description": "ServiceMonitor endpoints.",
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "port": {
                                        "type": "string"
                                    },
                                    "scheme": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "labels": {
                            "description": "Extra ServiceMonitor labels (e.g. `release: kube-prometheus-stack`).",
                            "type": "object"
                        }
                    }
                },
                "statsGroups": {
                    "description": "Statistics groups to collect (`tasks` is deprecated since bind_exporter 0.8.0).",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "nameOverride": {
            "description": "Override the chart name.",
            "type": "string"
        },
        "networkPolicy": {
            "type": "object",
            "properties": {
                "adminAllowedFrom": {
                    "description": "Peers allowed to reach rndc and metrics (e.g. your Prometheus namespace).",
                    "type": "array"
                },
                "enabled": {
                    "description": "Create a NetworkPolicy: DNS stays open, rndc and metrics only accept the peers below.",
                    "type": "boolean"
                }
            }
        },
        "nodeSelector": {
            "description": "Node selector. The ISC image is published for linux/amd64 only, so the pods (and the `helm test` pod) only run on amd64 nodes. With a multi-architecture image, set `kubernetes.io/arch: null` to remove the constraint.",
            "type": "object",
            "properties": {
                "kubernetes.io/arch": {
                    "type": "string"
                }
            }
        },
        "persistence": {
            "type": "object",
            "properties": {
                "accessMode": {
                    "description": "Access mode.",
                    "type": "string"
                },
                "emptyDirSizeLimit": {
                    "description": "Size limit of the emptyDir used when persistence is disabled.",
                    "type": "string"
                },
                "enabled": {
                    "description": "Persist /var/lib/bind in a PVC. Without it an emptyDir is used.",
                    "type": "boolean"
                },
                "existingClaim": {
                    "description": "Use an existing PVC.",
                    "type": "string"
                },
                "size": {
                    "description": "Volume size.",
                    "type": "string"
                },
                "storageClass": {
                    "description": "Storage class (empty uses the cluster default).",
                    "type": "string"
                }
            }
        },
        "podAnnotations": {
            "description": "Pod annotations.",
            "type": "object"
        },
        "podDisruptionBudget": {
            "type": "object",
            "properties": {
                "enabled": {
                    "description": "Create a PodDisruptionBudget (useful with 2+ replicas).",
                    "type": "boolean"
                },
                "maxUnavailable": {
                    "description": "Maximum unavailable pods (used instead of minAvailable when set).",
                    "type": [
                        "integer",
                        "string",
                        "null"
                    ]
                },
                "minAvailable": {
                    "description": "Minimum available pods.",
                    "type": "integer"
                }
            }
        },
        "podLabels": {
            "description": "Pod labels.",
            "type": "object"
        },
        "podSecurityContext": {
            "description": "Pod security context. named runs as the `bind` user of the image (uid 53) from the start, without any capability: the `net.ipv4.ip_unprivileged_port_start` sysctl (a safe sysctl, allowed by the `restricted` Pod Security Standard) lets it bind port 53 in the pod's network namespace. Keep the sysctl if you override this value.",
            "type": "object"
        },
        "preStopSleepSeconds": {
            "description": "Seconds named keeps answering after its pod is marked for deletion, before it gets SIGTERM (preStop hook). The pod leaves the Service endpoints while it stops: without this delay, queries still routed to it during a rolling update or a drain are refused. 0 removes the hook. The hook uses the `sleep` action on Kubernetes 1.30 and later, and runs `sleep` from the image on older clusters.",
            "type": "integer",
            "minimum": 0
        },
        "priorityClassName": {
            "description": "Priority class of the pods.",
            "type": "string"
        },
        "readinessProbe": {
            "description": "Readiness probe.",
            "type": "object"
        },
        "replicaCount": {
            "description": "Number of Bind9 replicas. With `persistence.enabled` and a ReadWriteOnce volume, keep 1.",
            "type": "integer"
        },
        "resources": {
            "description": "Bind9 container resources.",
            "type": "object"
        },
        "securityContext": {
            "description": "Bind9 container security context: every capability dropped, read-only root filesystem.",
            "type": "object"
        },
        "service": {
            "type": "object",
            "properties": {
                "annotations": {
                    "description": "Service annotations (e.g. MetalLB or cloud load balancer settings).",
                    "type": "object"
                },
                "enabled": {
                    "description": "Create the DNS service.",
                    "type": "boolean"
                },
                "exposeRndc": {
                    "description": "Expose the rndc control port through the admin Service (`adminService`), never the DNS Service. Off by default: rndc is an administrative channel.",
                    "type": "boolean"
                },
                "externalTrafficPolicy": {
                    "description": "`Local` preserves client source IPs (needed by ACLs such as allow-transfer).",
                    "type": "string"
                },
                "loadBalancerIP": {
                    "description": "Load balancer IP, when supported by the provider.",
                    "type": "string"
                },
                "loadBalancerSourceRanges": {
                    "description": "Source ranges allowed by the load balancer.",
                    "type": "array"
                },
                "ports": {
                    "type": "object",
                    "properties": {
                        "dnsTcp": {
                            "description": "DNS TCP port.",
                            "type": "integer"
                        },
                        "dnsTcpNodePort": {
                            "description": "NodePort for DNS over TCP.",
                            "type": [
                                "integer",
                                "null"
                            ]
                        },
                        "dnsUdp": {
                            "description": "DNS UDP port.",
                            "type": "integer"
                        },
                        "dnsUdpNodePort": {
                            "description": "NodePort for DNS over UDP.",
                            "type": [
                                "integer",
                                "null"
                            ]
                        },
                        "metrics": {
                            "description": "Prometheus exporter port, in the pod and on the admin Service.",
                            "type": "integer"
                        },
                        "metricsNodePort": {
                            "description": "NodePort for the metrics port, when `adminService.type` is NodePort or LoadBalancer.",
                            "type": [
                                "integer",
                                "null"
                            ]
                        },
                        "rndc": {
                            "description": "rndc port of the admin Service (only with `service.exposeRndc`).",
                            "type": "integer"
                        },
                        "rndcNodePort": {
                            "description": "NodePort for rndc, when `adminService.type` is NodePort or LoadBalancer.",
                            "type": [
                                "integer",
                                "null"
                            ]
                        }
                    }
                },
                "type": {
                    "description": "Service type.",
                    "type": "string",
                    "enum": [
                        "ClusterIP",
                        "NodePort",
                        "LoadBalancer"
                    ]
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "annotations": {
                    "description": "Service account annotations.",
                    "type": "object"
                },
                "automount": {
                    "description": "Bind9 never talks to the Kubernetes API: the token is not mounted.",
                    "type": "boolean"
                },
                "create": {
                    "description": "Create a dedicated service account.",
                    "type": "boolean"
                },
                "name": {
                    "description": "Service account name (generated when empty).",
                    "type": "string"
                }
            }
        },
        "terminationGracePeriodSeconds": {
            "description": "Grace period of the pods: the preStop sleep, then the time named has to stop after SIGTERM. Must be greater than `preStopSleepSeconds`.",
            "type": "integer",
            "minimum": 0
        },
        "tolerations": {
            "description": "Tolerations.",
            "type": "array"
        },
        "topologySpreadConstraints": {
            "description": "Topology spread constraints.",
            "type": "array"
        },
        "volumeMounts": {
            "description": "Additional volumeMounts on the Bind9 container.",
            "type": "array"
        },
        "volumes": {
            "description": "Additional volumes on the pod.",
            "type": "array"
        }
    }
}
