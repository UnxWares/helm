{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "affinity": {
            "description": "Affinity rules.",
            "type": "object"
        },
        "autoscaling": {
            "type": "object",
            "properties": {
                "enabled": {
                    "description": "Enable the HorizontalPodAutoscaler (only without server storage, or with a ReadWriteMany volume).",
                    "type": "boolean"
                },
                "maxReplicas": {
                    "description": "Maximum replicas.",
                    "type": "integer"
                },
                "minReplicas": {
                    "description": "Minimum replicas.",
                    "type": "integer"
                },
                "targetCPUUtilizationPercentage": {
                    "description": "Target CPU utilization.",
                    "type": "integer"
                },
                "targetMemoryUtilizationPercentage": {
                    "description": "Target memory utilization.",
                    "type": [
                        "integer",
                        "null"
                    ]
                }
            }
        },
        "extraEnv": {
            "description": "Extra environment variables. HTTP_AUTH_USER/HTTP_AUTH_PASSWORD do not work: the upstream image fails to build its password file (OpenSSL 3 has no bcrypt) and the UnxWares image refuses to start with them. Protect FossFLOW at the ingress level instead.",
            "type": "array"
        },
        "extraEnvFrom": {
            "description": "Extra envFrom sources.",
            "type": "array"
        },
        "fullnameOverride": {
            "description": "Override the full resource names.",
            "type": "string"
        },
        "httpRoute": {
            "type": "object",
            "properties": {
                "annotations": {
                    "description": "HTTPRoute annotations.",
                    "type": "object"
                },
                "enabled": {
                    "description": "Expose FossFLOW through a Gateway API HTTPRoute.",
                    "type": "boolean"
                },
                "hostnames": {
                    "description": "Hostnames.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "parentRefs": {
                    "description": "Gateways this route is attached to.",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "sectionName": {
                                "type": "string"
                            }
                        }
                    }
                },
                "rules": {
                    "description": "Rules (every rule is sent to the FossFLOW service).",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "matches": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "path": {
                                            "type": "object",
                                            "properties": {
                                                "type": {
                                                    "type": "string"
                                                },
                                                "value": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "image": {
            "type": "object",
            "properties": {
                "digest": {
                    "description": "Image digest (`sha256:...`). When set, it takes precedence over the tag.",
                    "type": "string"
                },
                "pullPolicy": {
                    "description": "Image pull policy.",
                    "type": "string",
                    "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                    ]
                },
                "repository": {
                    "description": "Image repository. Empty: `ghcr.io/unxwares/fossflow` or `docker.io/abrar74774/fossflow`, from `imageProvider`.",
                    "type": "string"
                },
                "tag": {
                    "description": "Image tag. Empty: the chart appVersion for the UnxWares image, `master-2b3cee3` for the upstream one (upstream only publishes `master-\u003ccommit\u003e` tags: `master-2b3cee3` is release v1.0.5).",
                    "type": "string"
                }
            }
        },
        "imageProvider": {
            "description": "Image provider. `unxwares`: `ghcr.io/unxwares/fossflow`, FossFLOW built from the upstream sources with updated dependencies on a current Alpine, rebuilt twice a week, signed (https://github.com/UnxWares/helm/tree/main/images): nginx on port 8080 and the backend run as a non-root user, with a read-only root filesystem. `upstream`: `docker.io/abrar74774/fossflow`, built by the maintained continuation of FossFLOW (github.com/Abrar74774/FossFLOW), which starts as root (nginx on port 80, backend through su-exec) with a writable root filesystem.",
            "type": "string",
            "enum": [
                "unxwares",
                "upstream"
            ]
        },
        "imagePullSecrets": {
            "description": "Secrets for pulling images from a private registry.",
            "type": "array"
        },
        "ingress": {
            "type": "object",
            "properties": {
                "annotations": {
                    "description": "Ingress annotations (add authentication here, e.g. oauth2-proxy or basic auth).",
                    "type": "object"
                },
                "className": {
                    "description": "Ingress class name.",
                    "type": "string"
                },
                "enabled": {
                    "description": "Expose FossFLOW through an Ingress.",
                    "type": "boolean"
                },
                "hosts": {
                    "description": "Ingress hosts.",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "host": {
                                "type": "string"
                            },
                            "paths": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "path": {
                                            "type": "string"
                                        },
                                        "pathType": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "tls": {
                    "description": "Ingress TLS.",
                    "type": "array"
                }
            }
        },
        "livenessProbe": {
            "description": "Liveness probe (same `/api/storage/status` substitution as the readiness probe).",
            "type": "object"
        },
        "nameOverride": {
            "description": "Override the chart name.",
            "type": "string"
        },
        "networkPolicy": {
            "type": "object",
            "properties": {
                "enabled": {
                    "description": "Create a NetworkPolicy: FossFLOW only accepts traffic on its HTTP port and opens no connection (no egress at all).",
                    "type": "boolean"
                },
                "ingressFrom": {
                    "description": "Peers allowed to reach FossFLOW (e.g. your ingress controller). Empty allows any source on the HTTP port; pods of this release are always allowed.",
                    "type": "array"
                }
            }
        },
        "nodeSelector": {
            "description": "Node selector.",
            "type": "object"
        },
        "persistence": {
            "type": "object",
            "properties": {
                "accessModes": {
                    "description": "Access modes.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "annotations": {
                    "description": "PVC annotations.",
                    "type": "object"
                },
                "enabled": {
                    "description": "Persist the diagrams (/data/diagrams) when `storage.enabled`.",
                    "type": "boolean"
                },
                "existingClaim": {
                    "description": "Use an existing PVC.",
                    "type": "string"
                },
                "size": {
                    "description": "Volume size.",
                    "type": "string"
                },
                "storageClass": {
                    "description": "Storage class (empty uses the cluster default).",
                    "type": "string"
                }
            }
        },
        "podAnnotations": {
            "description": "Pod annotations.",
            "type": "object"
        },
        "podLabels": {
            "description": "Pod labels.",
            "type": "object"
        },
        "podSecurityContext": {
            "description": "Pod security context. Empty: the defaults of `imageProvider`, `fsGroup` `storage.gid` and seccomp `RuntimeDefault`, plus `runAsNonRoot` as `storage.uid`:`storage.gid` with the UnxWares image (see Security in the README).",
            "type": "object"
        },
        "readinessProbe": {
            "description": "Readiness probe. With `storage.enabled` and the default path `/`, the chart probes `/api/storage/status` instead, so a dead backend makes the pod unready.",
            "type": "object"
        },
        "replicaCount": {
            "description": "Number of replicas. With server storage on a ReadWriteOnce volume, keep 1.",
            "type": "integer"
        },
        "resources": {
            "description": "Resources.",
            "type": "object"
        },
        "securityContext": {
            "description": "Container security context. Empty: the defaults of `imageProvider`. UnxWares image: read-only root filesystem, every capability dropped. Upstream image: its entrypoint must start as root (nginx binds port 80 and rewrites its configuration, the backend is started through su-exec), so every capability is dropped except the five it needs.",
            "type": "object"
        },
        "service": {
            "type": "object",
            "properties": {
                "port": {
                    "description": "Service port (the container listens on 8080 with the UnxWares image, 80 with the upstream one).",
                    "type": "integer"
                },
                "type": {
                    "description": "Service type.",
                    "type": "string",
                    "enum": [
                        "ClusterIP",
                        "NodePort",
                        "LoadBalancer"
                    ]
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "annotations": {
                    "description": "Service account annotations.",
                    "type": "object"
                },
                "automount": {
                    "description": "FossFLOW never talks to the Kubernetes API: the token is not mounted.",
                    "type": "boolean"
                },
                "create": {
                    "description": "Create a dedicated service account.",
                    "type": "boolean"
                },
                "name": {
                    "description": "Service account name (generated when empty).",
                    "type": "string"
                }
            }
        },
        "storage": {
            "type": "object",
            "properties": {
                "enabled": {
                    "description": "Save diagrams on the server (Node.js backend + volume). When false, diagrams only live in the browser.",
                    "type": "boolean"
                },
                "gid": {
                    "description": "Group of the diagrams (`fsGroup` of the pod; `PGID` with the upstream image).",
                    "type": "integer"
                },
                "uid": {
                    "description": "User that owns the diagrams. The UnxWares image runs nginx and the backend as this user; the upstream image starts as root and drops the backend to it (`PUID`), nginx keeping its own `nginx` user.",
                    "type": "integer"
                }
            }
        },
        "terminationGracePeriodSeconds": {
            "description": "Grace period of the pod. The UnxWares image stops nginx and the backend on SIGTERM; the upstream entrypoint does not forward it, so the pod waits for the whole period.",
            "type": "integer"
        },
        "tolerations": {
            "description": "Tolerations.",
            "type": "array"
        },
        "volumeMounts": {
            "description": "Additional volumeMounts on the output Deployment definition.",
            "type": "array"
        },
        "volumes": {
            "description": "Additional volumes on the output Deployment definition.",
            "type": "array"
        }
    }
}
