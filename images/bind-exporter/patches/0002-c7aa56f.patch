From c7aa56fd45e3b7cf1a4d806c69181cb9dda86a13 Mon Sep 17 00:00:00 2001
From: BaptGosse <baptiste.gosselin@unxwares.com>
Date: Thu, 12 Nov 2026 14:50:04 +0100
Subject: [PATCH] Update golang.org/x/crypto to v0.59.0

Scanners flag golang.org/x/crypto v0.58.0 for GO-2026-5932, the
deprecation advisory of the golang.org/x/crypto/openpgp packages, which
v0.59.0 removes. bind_exporter does not import them; it uses
x/crypto/bcrypt through exporter-toolkit. go mod tidy moves sync to
v0.25.0, sys to v0.50.0 and text to v0.44.0 with it.

Signed-off-by: BaptGosse <baptiste.gosselin@unxwares.com>
---
 go.mod |  8 ++++----
 go.sum | 16 ++++++++--------
 2 files changed, 12 insertions(+), 12 deletions(-)

diff --git a/go.mod b/go.mod
index ae68b85..0b9bdbb 100644
--- a/go.mod
+++ b/go.mod
@@ -25,12 +25,12 @@ require (
 	github.com/prometheus/procfs v0.22.0 // indirect
 	github.com/xhit/go-str2duration/v2 v2.1.0 // indirect
 	go.yaml.in/yaml/v2 v2.4.4 // indirect
-	golang.org/x/crypto v0.58.0 // indirect
+	golang.org/x/crypto v0.59.0 // indirect
 	golang.org/x/net v0.62.0 // indirect
 	golang.org/x/oauth2 v0.37.0 // indirect
-	golang.org/x/sync v0.24.0 // indirect
-	golang.org/x/sys v0.49.0 // indirect
-	golang.org/x/text v0.43.0 // indirect
+	golang.org/x/sync v0.25.0 // indirect
+	golang.org/x/sys v0.50.0 // indirect
+	golang.org/x/text v0.44.0 // indirect
 	golang.org/x/time v0.15.0 // indirect
 	google.golang.org/protobuf v1.36.12 // indirect
 )
