From 4685be338d7beffa9ba090b13dbaa2f7ef5c0291 Mon Sep 17 00:00:00 2001
From: BaptGosse <baptiste.gosselin@unxwares.com>
Date: Thu, 29 Oct 2026 20:34:29 +0100
Subject: [PATCH] Update golang.org/x dependencies

Bump golang.org/x/net from v0.59.0 to v0.62.0, which scanners flag for
CVE-2026-78669 (GO-2026-6611) in the published image. go mod tidy moves the
other golang.org/x modules with it: crypto v0.58.0, sync v0.24.0,
sys v0.49.0 and text v0.43.0.

Signed-off-by: BaptGosse <baptiste.gosselin@unxwares.com>
---
 go.mod | 10 +++++-----
 go.sum | 20 ++++++++++----------
 2 files changed, 15 insertions(+), 15 deletions(-)

diff --git a/go.mod b/go.mod
index 688cd7d..ae68b85 100644
--- a/go.mod
+++ b/go.mod
@@ -25,12 +25,12 @@ require (
 	github.com/prometheus/procfs v0.22.0 // indirect
 	github.com/xhit/go-str2duration/v2 v2.1.0 // indirect
 	go.yaml.in/yaml/v2 v2.4.4 // indirect
-	golang.org/x/crypto v0.57.0 // indirect
-	golang.org/x/net v0.59.0 // indirect
+	golang.org/x/crypto v0.58.0 // indirect
+	golang.org/x/net v0.62.0 // indirect
 	golang.org/x/oauth2 v0.37.0 // indirect
-	golang.org/x/sync v0.23.0 // indirect
-	golang.org/x/sys v0.48.0 // indirect
-	golang.org/x/text v0.42.0 // indirect
+	golang.org/x/sync v0.24.0 // indirect
+	golang.org/x/sys v0.49.0 // indirect
+	golang.org/x/text v0.43.0 // indirect
 	golang.org/x/time v0.15.0 // indirect
 	google.golang.org/protobuf v1.36.12 // indirect
 )
